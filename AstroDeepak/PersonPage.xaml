<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroDeepak.PersonPage"
             Title="Person Details">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Entry x:Name="NameEntry" Placeholder="Name" />
            <Entry x:Name="FatherNameEntry" Placeholder="Father's Name" />
            <Entry x:Name="GotraEntry" Placeholder="Gotra" />
            <DatePicker x:Name="DobPicker" />
            <Entry x:Name="TimeEntry" Placeholder="Time (e.g. 10:30 AM)" />
            <Entry x:Name="BirthPlaceEntry" Placeholder="Birth Place" />
            <Entry x:Name="PhoneEntry" Placeholder="Phone / WhatsApp No." Keyboard="Telephone" />
            <Entry x:Name="AddressEntry" Placeholder="Address" />

            <Label Text="Grahan Type" FontAttributes="Bold" />
            <Picker x:Name="GrahanPicker" Title="Select Grahan Type">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Chandra Grahan</x:String>
                        <x:String>Surya Grahan</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>

            <Button Text="Save" Clicked="OnSaveClicked" BackgroundColor="#512BD4" TextColor="White" />
            <Button Text="View All Records" Clicked="OnViewAllClicked" />

            <CollectionView x:Name="RecordsList" Margin="0,20,0,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" ColumnDefinitions="*,Auto,Auto">
                            <Label Text="{Binding Name}" Grid.Column="0" VerticalOptions="Center"/>
                            <Button Text="Edit" Grid.Column="1"
                                    Clicked="OnEditClicked" CommandParameter="{Binding Id}"/>
                            <Button Text="Delete" Grid.Column="2" BackgroundColor="Red" TextColor="White"
                                    Clicked="OnDeleteClicked" CommandParameter="{Binding Id}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>