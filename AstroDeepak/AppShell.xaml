<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AstroDeepak.Views"
    x:Class="AstroDeepak.AppShell"

    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False"

    BackgroundColor="Black"

    Shell.TabBarBackgroundColor="Black"
    Shell.TabBarTitleColor="Gold"
    Shell.TabBarUnselectedColor="White">

    <FlyoutItem FlyoutDisplayOptions="AsSingleItem">

        <Tab>
            <ShellContent
                Title="Open Kundli"
                Route="search"
                ContentTemplate="{DataTemplate views:SearchPage}" />

            <ShellContent
                Title="New Kundli"
                Route="form"
                ContentTemplate="{DataTemplate views:PersonFormPage}" />
        </Tab>

    </FlyoutItem>

</Shell>