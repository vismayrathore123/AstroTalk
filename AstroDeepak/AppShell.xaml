<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:AstroDeepak.Views"
       x:Class="AstroDeepak.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       BackgroundColor="{StaticResource DeepSpace}">

    <TabBar>
        <ShellContent
            Title="Open Kundli"
            Route="search"
            ContentTemplate="{DataTemplate views:SearchPage}" />

        <ShellContent
            Title="New Kundli"
            Route="form"
            ContentTemplate="{DataTemplate views:PersonFormPage}" />
    </TabBar>

</Shell>