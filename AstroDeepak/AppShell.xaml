<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:AstroDeepak.Views"
       x:Class="AstroDeepak.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="True"
       Shell.BackgroundColor="{StaticResource DeepSpace}"
       Shell.TitleColor="{StaticResource TextPrimary}"
       BackgroundColor="{StaticResource DeepSpace}">

    <ShellContent
        Title="AstroDeepak"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="main" />

</Shell>