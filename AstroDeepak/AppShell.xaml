<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:AstroDeepak.Views"
       x:Class="AstroDeepak.AppShell"
       FlyoutBehavior="Disabled"
     Shell.NavBarIsVisible="False"
Shell.TabBarBackgroundColor="Black"
Shell.TabBarTitleColor="{StaticResource Gold}"
Shell.TabBarUnselectedColor="{StaticResource TextSecondary}"
BackgroundColor="Black">
    <FlyoutItem FlyoutDisplayOptions="AsSingleItem">
        <Tab>
            <ShellContent
                Title="Open Kundli"
                Route="search"
                ContentTemplate="{DataTemplate views:SearchPage}" />

            <ShellContent
                Title="New Kundli"
                Route="form"
                ContentTemplate="{DataTemplate views:PersonFormPage}" />
        </Tab>
    </FlyoutItem>

</Shell>