<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroDeepak.Views.NavgrahListPage"
             Title="Select Navgrah">

    <Grid Padding="20" RowDefinitions="Auto,*,Auto">

        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End" Margin="0,0,0,8">
            <Button Text="←" Style="{StaticResource IconButton}" Clicked="OnBackClicked" />
        </HorizontalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="14" Padding="0,0,0,20">

                <VerticalStackLayout Spacing="2">
                    <Label Text="Choose ONE Grah" Style="{StaticResource TitleLabel}" FontSize="22" />
                    <Label Text="Tap a planet below - only a single selection is allowed"
                           Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>

                <!-- Rows of Grah tiles are built here in code-behind.
                     Each row carries its own accordion slot for remedies. -->
                <VerticalStackLayout x:Name="GrahGridHost" Spacing="12" />

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="2" x:Name="ConfirmButton" Text="Add Remedies →"
                Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                IsEnabled="False" Clicked="OnConfirmClicked" />

    </Grid>

</ContentPage>