<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroDeepak.Views.NavgrahListPage"
             Title="Select Navgrah">

    <Grid>

        <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto">

            <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Start" Spacing="8" Margin="0,0,0,8">
                <Button x:Name="HamburgerButton" Text="☰" Style="{StaticResource IconButton}" Clicked="OnHamburgerClicked" />
                <Button Text="←" Style="{StaticResource IconButton}" Clicked="OnBackClicked" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="2">
                <Label Text="Choose ONE Grah" Style="{StaticResource TitleLabel}" FontSize="22" />
                <Label Text="Tap a planet below - only a single selection is allowed"
                       Style="{StaticResource SubtitleLabel}" />
            </VerticalStackLayout>

            <ScrollView Grid.Row="2">
                <VerticalStackLayout Spacing="14" Padding="0,10,0,20">

                    <!-- Rows of Grah tiles are built here in code-behind.
                         Each row carries its own accordion slot for remedies. -->
                    <VerticalStackLayout x:Name="GrahGridHost" Spacing="12" />

                    <!-- Global precautions checklist for this person, applies
                         regardless of which Grah(s) are selected. -->
                    <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,16,0,0">
                        <VerticalStackLayout Spacing="10">
                            <Label Text="Precautions" Style="{StaticResource TitleLabel}" FontSize="18" />
                            <Label Text="Select any precautions that apply to this person"
                                   Style="{StaticResource SubtitleLabel}" />
                            <VerticalStackLayout x:Name="PrecautionsHost" Spacing="8" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>

            <Button Grid.Row="3" x:Name="ConfirmButton" Text="Add Remedies →"
                    Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                    IsEnabled="False" Clicked="OnConfirmClicked" />

        </Grid>

        <BoxView x:Name="MenuOverlayBackground" IsVisible="False" BackgroundColor="Transparent" InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="MenuDropdown" IsVisible="False"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="18,54,0,0" Padding="0"
                StrokeShape="RoundRectangle 10" Stroke="{StaticResource GoldSoft}" StrokeThickness="1"
                BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.15" Radius="12" Offset="0,4" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="0" WidthRequest="170">
                <Label Text="Add Remedies" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddRemediesTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#E5E5E5" />
                <Label Text="Precautions" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrecautionsTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#E5E5E5" />
                <Label Text="Contact Us" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContactUsTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>