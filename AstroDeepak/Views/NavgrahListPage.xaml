<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:AstroDeepak.Views"
             x:Class="AstroDeepak.Views.NavgrahListPage"
             Title="Select Navgrah">

    <Grid Padding="20" RowDefinitions="Auto,Auto,*,Auto">

        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End" Margin="0,0,0,8">
            <Button Text="←" Style="{StaticResource IconButton}" Clicked="OnBackClicked" />
        </HorizontalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="2" Margin="0,0,0,14">
            <Label Text="Choose ONE Grah" Style="{StaticResource TitleLabel}" FontSize="22" />
            <Label Text="Tap a planet below - only a single selection is allowed"
                   Style="{StaticResource SubtitleLabel}" />
        </VerticalStackLayout>

        <CollectionView Grid.Row="2" x:Name="GrahList"
                         SelectionMode="Single"
                         SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="12" HorizontalItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="views:NavgrahOption">
                    <Grid>
                        <Border Style="{StaticResource CardBorder}" Padding="8" HeightRequest="80">
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="4">
                                <Label Text="{Binding Name}" FontSize="14" HorizontalOptions="Center"
                                       HorizontalTextAlignment="Center" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3" x:Name="ConfirmButton" Text="Add Remedies →"
                Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                IsEnabled="False" Clicked="OnConfirmClicked" />

    </Grid>

</ContentPage>