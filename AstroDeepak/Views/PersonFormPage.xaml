<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroDeepak.Views.PersonFormPage"
             Title="Kundli Details">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <HorizontalStackLayout HorizontalOptions="End" Margin="0,0,0,4">
                <Button Text="☰" Style="{StaticResource IconButton}" Clicked="OnHamburgerClicked" />
            </HorizontalStackLayout>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="NAME" Style="{StaticResource SubtitleLabel}" />
                    <Entry x:Name="NameEntry" Placeholder="Full name" />

                    <Label Text="FATHER'S NAME" Style="{StaticResource SubtitleLabel}" />
                    <Entry x:Name="FatherNameEntry" Placeholder="Father's name" />

                    <Label Text="GOTRA" Style="{StaticResource SubtitleLabel}" />
                    <Entry x:Name="GotraEntry" Placeholder="Gotra" />

                    <Label Text="DATE OF BIRTH" Style="{StaticResource SubtitleLabel}" />
                    <DatePicker x:Name="DobPicker" />

                    <Label Text="TIME OF BIRTH" Style="{StaticResource SubtitleLabel}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Entry x:Name="TimeEntry" Grid.Column="0" Placeholder="e.g. 10:30" Keyboard="Numeric" />
                        <Picker x:Name="AmPmPicker" Grid.Column="1" WidthRequest="100" Title="AM/PM" />
                    </Grid>

                    <Label Text="BIRTH PLACE" Style="{StaticResource SubtitleLabel}" />
                    <Entry x:Name="BirthPlaceEntry" Placeholder="Birth place" />

                    <Label Text="PHONE / WHATSAPP" Style="{StaticResource SubtitleLabel}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Picker x:Name="CountryCodePicker" Grid.Column="0" WidthRequest="150" Title="Country" />
                        <Entry x:Name="PhoneEntry" Grid.Column="1" Placeholder="10-digit number" Keyboard="Telephone" />
                    </Grid>

                    <Label Text="ADDRESS" Style="{StaticResource SubtitleLabel}" />
                    <Editor x:Name="AddressEntry" Placeholder="Address" AutoSize="TextChanges" />

                    <Label Text="GRAHAN" Style="{StaticResource SubtitleLabel}" />
                    <Picker x:Name="GrahanPicker" Title="Select Grahan"
                            ItemDisplayBinding="{Binding Name}" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Submit  →  Select Grah" Style="{StaticResource PrimaryButton}"
                    Clicked="OnSubmitClicked" Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>