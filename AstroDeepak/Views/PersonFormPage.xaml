<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroDeepak.Views.PersonFormPage"
             Title="Kundli Details">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="14">

                <HorizontalStackLayout HorizontalOptions="Start" Margin="0,0,0,4">
                    <Button x:Name="HamburgerButton" Text="☰" Style="{StaticResource IconButton}" Clicked="OnHamburgerClicked" />
                </HorizontalStackLayout>

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="NAME *" Style="{StaticResource SubtitleLabel}" />
                        <Entry x:Name="NameEntry" Placeholder="Full name" />

                        <Label Text="FATHER'S NAME" Style="{StaticResource SubtitleLabel}" />
                        <Entry x:Name="FatherNameEntry" Placeholder="Father's name" />

                        <Label Text="GOTRA" Style="{StaticResource SubtitleLabel}" />
                        <Entry x:Name="GotraEntry" Placeholder="Gotra" />

                        <Label Text="DATE OF BIRTH *" Style="{StaticResource SubtitleLabel}" />
                        <DatePicker x:Name="DobPicker" />

                        <Label Text="TIME OF BIRTH *" Style="{StaticResource SubtitleLabel}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Entry x:Name="TimeEntry" Grid.Column="0" Placeholder="e.g. 10:30"
       Keyboard="Default" MaxLength="5" />
                            <Picker x:Name="AmPmPicker" Grid.Column="1" WidthRequest="100" Title="AM/PM" />
                        </Grid>

                        <Label Text="BIRTH PLACE *" Style="{StaticResource SubtitleLabel}" />
                        <Entry x:Name="BirthPlaceEntry" Placeholder="Birth place" />

                        <Label Text="PHONE / WHATSAPP *" Style="{StaticResource SubtitleLabel}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Picker x:Name="CountryCodePicker" Grid.Column="0" WidthRequest="150" Title="Country" />
                            <Entry x:Name="PhoneEntry" Grid.Column="1" Placeholder="10-digit number"
                                   Keyboard="Telephone" MaxLength="10" />
                        </Grid>

                        <Label Text="ADDRESS" Style="{StaticResource SubtitleLabel}" />
                        <Editor x:Name="AddressEntry" Placeholder="Address" AutoSize="TextChanges" />

                        <Label Text="GRAHAN" Style="{StaticResource SubtitleLabel}" />
                        <Picker x:Name="GrahanPicker" Title="Select Grahan"
                                ItemDisplayBinding="{Binding Name}" />

                        <Label Text="* Required fields" Style="{StaticResource SubtitleLabel}"
                               FontSize="11" Margin="0,4,0,0" />

                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,10,0,0">
                    <Button Grid.Column="0" Text="Reset" Style="{StaticResource SecondaryButton}"
            Clicked="OnResetClicked" />
                    <Button Grid.Column="1" Text="Next" Style="{StaticResource PrimaryButton}"
            Clicked="OnSubmitClicked" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>

        <BoxView x:Name="MenuOverlayBackground" IsVisible="False" BackgroundColor="Transparent" InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="MenuDropdown" IsVisible="False"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="18,54,0,0" Padding="0"
                StrokeShape="RoundRectangle 10" Stroke="{StaticResource GoldSoft}" StrokeThickness="1"
                BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.15" Radius="12" Offset="0,4" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="0" WidthRequest="170">
                <Label Text="Add Remedies" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddRemediesTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#E5E5E5" />
                <Label Text="Precautions" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrecautionsTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#E5E5E5" />
                <Label Text="Contact Us" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContactUsTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>