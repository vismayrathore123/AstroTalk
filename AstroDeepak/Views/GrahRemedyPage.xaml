<?xml version = "1.0" encoding = "UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:entities="clr-namespace:AstroDeepak.Domain.Entities"
             x:Class="AstroDeepak.Views.GrahRemedyPage"
             Title="Remedies">

    <Grid>

        <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,*">

            <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Start" Spacing="8" Margin="0,0,0,8">
                <Button x:Name="HamburgerButton" Text="☰" Style="{StaticResource IconButton}" Clicked="OnHamburgerClicked" />
                <Button Text="←" Style="{StaticResource IconButton}" Clicked="OnBackClicked" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Row="1" Spacing="2" Margin="0,0,0,14">
                <Label x:Name="HeaderLabel" Text="Remedies" Style="{StaticResource TitleLabel}" FontSize="22" />
                <Label Text="Add, edit, or remove remedies for this Grah"
                       Style="{StaticResource SubtitleLabel}" />
            </VerticalStackLayout>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="10">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="NewRemedyEntry" Grid.Column="0" Placeholder="Add a new remedy..." />
                    <Button Grid.Column="1" Text="+ Add" Clicked="OnAddRemedyClicked"
                            BackgroundColor="Transparent" TextColor="{StaticResource Gold}"
                            FontAttributes="Bold" />
                </Grid>
            </Border>

            <CollectionView Grid.Row="3" x:Name="RemedyList" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="entities:RemedyMaster">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <Label Grid.Column="0" Text="{Binding Name}" VerticalOptions="Center" FontSize="15" />
                                <Button Grid.Column="1" Text="✏️" FontSize="16"
                                        BackgroundColor="Transparent" WidthRequest="40" HeightRequest="40" Padding="0"
                                        Clicked="OnEditClicked" CommandParameter="{Binding .}" />
                                <Button Grid.Column="2" Text="🗑️" FontSize="16"
                                        BackgroundColor="Transparent" WidthRequest="40" HeightRequest="40" Padding="0"
                                        Clicked="OnDeleteClicked" CommandParameter="{Binding Id}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <BoxView x:Name="MenuOverlayBackground" IsVisible="False" BackgroundColor="Transparent" InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="MenuDropdown" IsVisible="False"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="18,54,0,0" Padding="0"
                StrokeShape="RoundRectangle 10" Stroke="{StaticResource GoldSoft}" StrokeThickness="1"
                BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.15" Radius="12" Offset="0,4" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="0" WidthRequest="170">
                <Label Text="Add Remedies" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddRemediesTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#E5E5E5" />
                <Label Text="Precautions" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrecautionsTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#E5E5E5" />
                <Label Text="Contact Us" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContactUsTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>