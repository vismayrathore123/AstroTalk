<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroDeepak.Views.MainPage"
             Shell.NavBarIsVisible="False">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="4" Margin="0,20,0,10">
            <Label Text="✨ AstroDeepak" Style="{StaticResource TitleLabel}" FontSize="34" />
            <Label Text="Kundli &amp; Navgrah Management" Style="{StaticResource SubtitleLabel}" />
        </VerticalStackLayout>

        <!-- Hamburger + Tabs -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" Margin="0,20,0,0" VerticalOptions="Center">

            <Button Grid.Column="0" Text="☰" FontSize="22"
                    BackgroundColor="Transparent" TextColor="{StaticResource TextPrimary}"
                    WidthRequest="46" HeightRequest="46" Padding="0"
                    Clicked="OnHamburgerClicked" />

            <HorizontalStackLayout Grid.Column="1" Spacing="28" Margin="10,0,0,0" VerticalOptions="Center">

                <VerticalStackLayout Spacing="4">
                    <Label Text="New Kundli" FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNewKundliTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView HeightRequest="3" CornerRadius="2" Color="{StaticResource Gold}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Open" FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOpenTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                    <BoxView HeightRequest="3" CornerRadius="2" Color="{StaticResource Gold}" />
                </VerticalStackLayout>

            </HorizontalStackLayout>
        </Grid>

        <BoxView Grid.Row="2" VerticalOptions="Start" HeightRequest="1"
                 Color="{StaticResource GoldSoft}" Margin="0,14,0,0" />

        <Label Grid.Row="3" Text="Made for AstroDeepak" HorizontalOptions="Center"
               Style="{StaticResource SubtitleLabel}" Margin="0,0,0,10" />
    </Grid>

</ContentPage>