<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroDeepak.Views.PreviewPage"
             Title="Preview">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="14">

                <HorizontalStackLayout HorizontalOptions="End" Margin="0,0,0,4">
                    <Button x:Name="HamburgerButton" Text="☰" Style="{StaticResource IconButton}" Clicked="OnHamburgerClicked" />
                </HorizontalStackLayout>

                <Label Text="Review Details" Style="{StaticResource TitleLabel}" FontSize="24" />
                <Label Text="Please confirm before saving" Style="{StaticResource SubtitleLabel}" Margin="0,0,0,10" />

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">

                        <VerticalStackLayout>
                            <Label Text="NAME" Style="{StaticResource SubtitleLabel}" />
                            <Label x:Name="NameLabel" FontSize="16" FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="FATHER'S NAME" Style="{StaticResource SubtitleLabel}" />
                            <Label x:Name="FatherNameLabel" FontSize="16" />
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="DATE OF BIRTH" Style="{StaticResource SubtitleLabel}" />
                            <Label x:Name="DobLabel" FontSize="16" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="SelectionsHost" Spacing="12" />

                        <VerticalStackLayout>
                            <Label Text="WHATSAPP NUMBER" Style="{StaticResource SubtitleLabel}" />
                            <Label x:Name="PhoneLabel" FontSize="16" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Button Text="Confirm" Style="{StaticResource SecondaryButton}"
                        Clicked="OnConfirmClicked" Margin="0,10,0,0" />

                <Button Text="Confirm &amp; WhatsApp" Style="{StaticResource PrimaryButton}"
                        Clicked="OnConfirmAndWhatsAppClicked" />

                <Button Text="Edit" Style="{StaticResource SecondaryButton}"
                        Clicked="OnEditClicked" />

            </VerticalStackLayout>
        </ScrollView>

        <BoxView x:Name="MenuOverlayBackground" IsVisible="False" BackgroundColor="Transparent" InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="MenuDropdown" IsVisible="False"
                HorizontalOptions="End" VerticalOptions="Start"
                Margin="0,54,18,0" Padding="0"
                StrokeShape="RoundRectangle 10" Stroke="{StaticResource GoldSoft}" StrokeThickness="1"
                BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.15" Radius="12" Offset="0,4" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="0" WidthRequest="170">
                <Label Text="Add Remedies" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddRemediesTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#E5E5E5" />
                <Label Text="Contact Us" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContactUsTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>