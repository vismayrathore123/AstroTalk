<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AstroDeepak.Views.PreviewPage"
             Title="Preview">

    <Grid>

        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <HorizontalStackLayout HorizontalOptions="Start" Margin="0,0,0,4">
                    <Button x:Name="HamburgerButton" Text="☰" Style="{StaticResource IconButton}" Clicked="OnHamburgerClicked" />
                </HorizontalStackLayout>

                <Label Text="ASTRODEEPAK" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       FontSize="26" FontAttributes="Bold" TextColor="{StaticResource Gold}" Margin="0,4,0,10" />

                <Border Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="6" HorizontalOptions="Start">
                            <Label x:Name="NameLabel" FontSize="18" FontAttributes="Bold" />
                            <Label x:Name="DobLabel" FontSize="15" Style="{StaticResource SubtitleLabel}" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#E5E5E5" Margin="0,4" />

                        <Label Text="PERMANENT REMEDY" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Gold}" />
                        <VerticalStackLayout x:Name="PermanentRemedyHost" Spacing="8" />
                        <Label x:Name="NoPermanentLabel" Text="None yet" IsVisible="False" Style="{StaticResource SubtitleLabel}" />

                        <Label Text="YEARLY REMEDY" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Gold}" Margin="0,10,0,0" />
                        <Label Text="Tick a remedy to also save it as permanent" Style="{StaticResource SubtitleLabel}" FontSize="11" />
                        <VerticalStackLayout x:Name="YearlyRemedyHost" Spacing="8" />
                        <Label x:Name="NoYearlyLabel" Text="None" IsVisible="False" Style="{StaticResource SubtitleLabel}" />

                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardBorder}" IsVisible="False" x:Name="PrecautionsCard">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="PRECAUTIONS" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Gold}" />
                        <VerticalStackLayout x:Name="PrecautionsHost" Spacing="4" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Download PDF" Style="{StaticResource SecondaryButton}"
                        Clicked="OnConfirmClicked" Margin="0,6,0,0" />

                <Label x:Name="WhatsAppTargetLabel" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       Style="{StaticResource SubtitleLabel}" FontSize="12" />

                <Button Text="Confirm &amp; WhatsApp" Style="{StaticResource PrimaryButton}"
                        Clicked="OnConfirmAndWhatsAppClicked" />

                <Button Text="Edit" Style="{StaticResource SecondaryButton}"
                        Clicked="OnEditClicked" />

                <VerticalStackLayout HorizontalOptions="Center" Margin="0,20,0,10" Spacing="2">
                    <Label Text="AstroDeepak" HorizontalTextAlignment="Center" FontAttributes="Bold" FontSize="14" />
                    <Label Text="1234567890" HorizontalTextAlignment="Center" Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <BoxView x:Name="MenuOverlayBackground" IsVisible="False" BackgroundColor="Transparent" InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="MenuDropdown" IsVisible="False"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="18,54,0,0" Padding="0"
                StrokeShape="RoundRectangle 10" Stroke="{StaticResource GoldSoft}" StrokeThickness="1"
                BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.15" Radius="12" Offset="0,4" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="0" WidthRequest="170">
                <Label Text="Add Remedies" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddRemediesTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#E5E5E5" />
                <Label Text="Precautions" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrecautionsTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#E5E5E5" />
                <Label Text="Contact Us" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContactUsTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>