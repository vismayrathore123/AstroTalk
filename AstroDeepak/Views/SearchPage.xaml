<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dtos="clr-namespace:AstroDeepak.Application.DTOs"
             x:Class="AstroDeepak.Views.SearchPage"
             Title="New Kundli">

    <Grid>

        <!-- Main page content -->
        <Grid Padding="18" RowDefinitions="Auto,Auto,Auto,*">

            <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Start" Margin="0,0,0,8">
                <Button x:Name="HamburgerButton" Text="☰" Style="{StaticResource IconButton}" Clicked="OnHamburgerClicked" />
            </HorizontalStackLayout>

            <!-- Search box -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14,4">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0" Text="🔍" VerticalOptions="Center" FontSize="18" />
                    <Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Search by name..."
                           TextChanged="OnSearchTextChanged" Margin="10,0" />
                </Grid>
            </Border>

            <Label Grid.Row="2" x:Name="SectionLabel" Text="RECENTLY ADDED" Margin="4,16,0,8"
                   Style="{StaticResource SubtitleLabel}" FontAttributes="Bold" />

            <CollectionView Grid.Row="3" x:Name="ResultsList" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:PersonDto">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                <Label Grid.Column="0" Text="🪐" FontSize="24" VerticalOptions="Center" />

                                <VerticalStackLayout Grid.Column="1" Margin="12,0" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                                    <Label Text="{Binding Subtitle}" Style="{StaticResource SubtitleLabel}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2" Text="{Binding Grah}" VerticalOptions="Center"
                                       TextColor="{StaticResource Gold}" FontSize="12" Margin="0,0,10,0" />

                                <Button Grid.Column="3" Text="✏️" FontSize="16"
                                        BackgroundColor="Transparent" WidthRequest="40" HeightRequest="40" Padding="0"
                                        Clicked="OnEditClicked" CommandParameter="{Binding Id}" />

                                <Button Grid.Column="4" Text="🗑️" FontSize="16"
                                        BackgroundColor="Transparent" WidthRequest="40" HeightRequest="40" Padding="0"
                                        Clicked="OnDeleteClicked" CommandParameter="{Binding Id}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </Grid>

        <!-- Invisible full-screen tap-catcher: tapping anywhere outside the dropdown closes it -->
        <BoxView x:Name="MenuOverlayBackground" IsVisible="False" BackgroundColor="Transparent" InputTransparent="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMenuOverlayTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Dropdown, pinned top-LEFT, right under the hamburger -->
        <Border x:Name="MenuDropdown" IsVisible="False"
                HorizontalOptions="Start" VerticalOptions="Start"
                Margin="18,54,0,0" Padding="0"
                StrokeShape="RoundRectangle 10" Stroke="{StaticResource GoldSoft}" StrokeThickness="1"
                BackgroundColor="White">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.15" Radius="12" Offset="0,4" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="0" WidthRequest="170">
                <Label Text="Add Remedies" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddRemediesTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#E5E5E5" />
                <Label Text="Precautions" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPrecautionsTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <BoxView HeightRequest="1" Color="#E5E5E5" />
                <Label Text="Contact Us" Padding="16,12" FontSize="15" TextColor="Black">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnContactUsTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>