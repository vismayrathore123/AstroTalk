<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <!-- All Target Platforms - each appears only once -->
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>AstroDeepak</RootNamespace>

    <!-- MAUI -->
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- XAML Source Generation -->
    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Application Information -->
    <ApplicationTitle>AstroDeepak</ApplicationTitle>
    <ApplicationId>com.companyname.astrodeepak</ApplicationId>

    <!-- Version -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Windows -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Minimum Supported Versions -->
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
      21.0
    </SupportedOSPlatformVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
      10.0.17763.0
    </SupportedOSPlatformVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
      15.0
    </SupportedOSPlatformVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
      15.0
    </SupportedOSPlatformVersion>

    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
      10.0.17763.0
    </TargetPlatformMinVersion>

  </PropertyGroup>


  <!-- NuGet Packages -->
  <ItemGroup>

    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.100" />

    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />

    <PackageReference Include="RestSharp" Version="114.0.0" />

    <PackageReference Include="sqlite-net-pcl" Version="1.11.285" />

    <PackageReference Include="QuestPDF" Version="2026.7.3" />

  </ItemGroup>


  <!-- XAML Pages -->
  <ItemGroup>

    <MauiXaml Update="PersonPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>

    <MauiXaml Update="Views\GrahRemedyPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>

    <MauiXaml Update="Views\MainPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>

    <MauiXaml Update="Views\NavgrahListPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>

    <MauiXaml Update="Views\PersonFormPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>

    <MauiXaml Update="Views\PrecautionsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>

    <MauiXaml Update="Views\PreviewPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>

    <MauiXaml Update="Views\SearchPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>

  </ItemGroup>


  <!-- Existing XAML Configuration -->
  <ItemGroup>

    <None Update="Views\GrahRemedyPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>

    <None Update="Views\PreviewPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>

  </ItemGroup>

</Project>